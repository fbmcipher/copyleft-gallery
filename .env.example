# Neuralwatt inference credentials — copy to .env and fill in.
# Get an API key at https://portal.neuralwatt.com (Dashboard → API Keys).

# OpenAI-compatible endpoint (from https://portal.neuralwatt.com/docs/quickstart)
NEURALWATT_API_BASE=https://api.neuralwatt.com/v1

# Required. Never commit the real key.
NEURALWATT_API_KEY=

# Optional. If unset, the server lists /v1/models at startup and picks a
# tool-calling-capable model automatically (logged on first request).
NEURALWATT_MODEL=

# Optional. Server port (default 3017).
# PORT=3017

# Optional. Hosted deployments use Postgres for durable curation storage.
# Local development continues to use data/curations when this is unset.
DATABASE_URL=

# Optional locally; strongly recommended for any publicly shared deployment.
SITE_USERNAME=gallery
SITE_PASSWORD=

# Optional. Brave Search API key (https://api-dashboard.search.brave.com) —
# powers the grounding pre-stage web sweep and the agent's searchWeb tool.
# Without it, grounding falls back to Wikipedia only.
BRAVE_API_KEY=

# Optional. Model for the planner pre-stage (text-only pass) — a fast variant
# keeps time-to-first-card low. Defaults to NEURALWATT_MODEL.
NEURALWATT_PLANNER_MODEL=kimi-k2.6-fast
